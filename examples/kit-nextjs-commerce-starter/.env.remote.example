# Copy to .env.local and fill in values for your remote Sitecore instance.

# --- Sitecore XM Cloud ---
SITECORE_EDITING_SECRET=
NEXT_PUBLIC_DEFAULT_SITE_NAME=
NEXT_PUBLIC_DEFAULT_LANGUAGE=
SITECORE_EDGE_CONTEXT_ID=
NEXT_PUBLIC_SITECORE_EDGE_CONTEXT_ID=

# Public origin (optional). Used when server code builds absolute URLs without a Host header.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BASE_URL=

# Optional Personalize isolation when multiple XM Cloud environments share a tenant.
NEXT_PUBLIC_PERSONALIZE_SCOPE=
PERSONALIZE_MIDDLEWARE_CDP_TIMEOUT=
PERSONALIZE_MIDDLEWARE_EDGE_TIMEOUT=

# Content SDK debug: DEBUG=content-sdk:*
#DEBUG=content-sdk:*

# Design Library (optional)
SITECORE_AUTH_CLIENT_ID=
SITECORE_AUTH_CLIENT_SECRET=

# --- OrderCloud shopping (direct sandbox, no storefront proxy) ---
# NEXT_PUBLIC_ORDERCLOUD_CLIENT_ID must be a real buyer API client with anonymous shopping.
NEXT_PUBLIC_ORDERCLOUD_BASE_API_URL=https://sandboxapi.ordercloud.io
NEXT_PUBLIC_ORDERCLOUD_CLIENT_ID=
NEXT_PUBLIC_ORDERCLOUD_ANONYMOUS_SCOPE=
NEXT_PUBLIC_ORDERCLOUD_CATALOG_ID=

# Incoming webhook pay/submit. Optional until OrderCloud middleware exists.
# Without these, /stripe/complete still acks checkout.session events (HTTP 200),
# and /stripe/status submits the shopper Outgoing order after Stripe reports paid.
# With these set, Stripe tax is written on Incoming. Unsubmitted carts are submitted
# as Outgoing first so the seller can see the order, then TaxCost is patched.
# ORDERCLOUD_MIDDLEWARE_CLIENT_ID=
# ORDERCLOUD_MIDDLEWARE_CLIENT_SECRET=
# Required to copy Stripe tax/shipping onto the Incoming order.
# ORDERCLOUD_MIDDLEWARE_SCOPE=OrderAdmin OverrideTax OverrideShipping

# --- Checkout gateway PoC ---
# Server-only Stripe secrets keyed by OrderCloud buyer API client ID (JWT cid).
# Next.js dotenv strips " from raw JSON; prefer a base64-encoded object in .env.local.
# Example JSON (encode before pasting): {"your-buyer-client-id":{"api_key":"sk_test_...","webhook_signing_secret":"whsec_...","return_url":"http://localhost:3000/checkout/success"}}
CHECKOUT_STRIPE_VAULT_JSON=

# Stripe CLI for the Incoming webhook PoC. `npm run dev` opens this in a new Terminal window.
# npm run stripe:listen
